                        print('You have selected ' + array[Selection - 1] + '.')
                        return Selection
                    case 0:
                        print('You have chosen to exit.') #exits
                        return 0
                    case _:
                      print('Invalid selection. Please try again.') #applies to everything invalid
                      continue

